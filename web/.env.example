# Server-only. Never prefixed with NEXT_PUBLIC_ — the browser must not learn the backend address.
# Compose sets this to http://app:8000; a host run needs the value below in web/.env.local.
# The production image bakes it in at BUILD time: next build writes the rewrite destination into
# .next/routes-manifest.json, so the prod compose profile passes it as a build arg, not at runtime.
API_ORIGIN=http://127.0.0.1:8000
