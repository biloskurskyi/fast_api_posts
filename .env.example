POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=app_db

DATABASE_URL=postgresql+psycopg://app_user:replace_with_a_local_password@db:5432/app_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=25

SECRET_KEY=replace_with_a_random_string_of_at_least_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

AUTO_REPLY_POLL_INTERVAL_SECONDS=5
AUTO_REPLY_BATCH_SIZE=100

MAX_REQUEST_BODY_BYTES=1048576
